<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.FensiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.FensiEntity" id="fensiMap">
        <result property="fensizhanghao" column="fensizhanghao"/>
        <result property="fensixingming" column="fensixingming"/>
        <result property="mima" column="mima"/>
        <result property="xingbie" column="xingbie"/>
        <result property="lianxidianhua" column="lianxidianhua"/>
        <result property="touxiang" column="touxiang"/>
        <result property="xiaimingxing" column="xiaimingxing"/>
        <result property="money" column="money"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.entity.vo.FensiVO" >
		SELECT * FROM fensi  fensi         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.FensiVO" >
		SELECT  fensi.* FROM fensi  fensi 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.FensiView" >

		SELECT  fensi.* FROM fensi  fensi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.FensiView" >
		SELECT * FROM fensi  fensi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
